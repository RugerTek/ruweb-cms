diff --git a/tests/Feature/DefaultTestimonialsTest.php b/tests/Feature/DefaultTestimonialsTest.php
new file mode 100644
index 0000000..b9e3c97
--- /dev/null
+++ b/tests/Feature/DefaultTestimonialsTest.php
@@ -0,0 +1,90 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Media;
+use App\Models\User;
+use App\Services\Pages\PageOperations;
+use Database\Seeders\PlaceholderMediaSeeder;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Validation\ValidationException;
+use Tests\TestCase;
+
+class DefaultTestimonialsTest extends TestCase
+{
+    use RefreshDatabase;
+
+    public function test_shared_operations_save_testimonials_and_render_square_placeholder_only_when_published(): void
+    {
+        $this->withoutVite();
+        $this->travelTo(now()->startOfDay());
+        Storage::fake('public');
+        $this->seed(PlaceholderMediaSeeder::class);
+        $portrait = Media::where('placeholder_key', 'square')->sole();
+        $this->assertSame($portrait->width, $portrait->height);
+
+        $actor = User::factory()->create(['role' => 'admin']);
+        $operations = app(PageOperations::class);
+        $page = $operations->save($actor, [
+            'title' => 'Clientes', 'slug' => 'clientes-testimonios', 'template_key' => 'default',
+            'content_json' => ['sections' => ['content' => ['heading' => 'Contenido existente', 'body' => 'Conservar este texto.']]],
+        ], draftOnly: true);
+        $testimonials = [
+            'heading' => 'Clientes que confían', 'is_visible' => true,
+            'items' => [['quote' => 'El equipo cumplió cada detalle.', 'author' => 'Ana Torres', 'role' => 'Directora', 'portrait_id' => $portrait->id]],
+        ];
+        $page = $operations->save($actor, ['content_json' => ['sections' => ['testimonials' => $testimonials]]], $page, draftOnly: true);
+        $this->assertSame($testimonials, $page->sections()['testimonials']);
+        $this->assertSame('Conservar este texto.', $page->sections()['content']['body']);
+        $this->get('/clientes-testimonios')->assertNotFound();
+
+        $page = $operations->publish($actor, $page);
+        $this->get('/clientes-testimonios')->assertOk()
+            ->assertSee('Contenido existente')->assertSee('Conservar este texto.')
+            ->assertSee('Clientes que confían')->assertSee('El equipo cumplió cada detalle.')
+            ->assertSee('Ana Torres')->assertSee('Directora')->assertSee($portrait->url, false)
+            ->assertSee('aspect-square', false);
+
+        $page->update(['published_at' => now()->addDay()]);
+        $this->get('/clientes-testimonios')->assertNotFound();
+        $page->update(['published_at' => now()->subMinute()]);
+        $page->update(['content_json' => ['sections' => ['testimonials' => array_replace($testimonials, ['is_visible' => false])]]]);
+        $this->get('/clientes-testimonios')->assertOk()->assertDontSee('Clientes que confían');
+        $page->update(['content_json' => ['sections' => ['testimonials' => array_replace($testimonials, ['items' => []])]]]);
+        $this->get('/clientes-testimonios')->assertOk()->assertDontSee('data-section="testimonials"', false);
+        $page->update(['content_json' => []]);
+        $this->get('/clientes-testimonios')->assertOk()->assertDontSee('data-section="testimonials"', false);
+    }
+
+    public function test_testimonial_media_and_repeaters_are_validated_by_shared_operations(): void
+    {
+        $actor = User::factory()->create(['role' => 'admin']);
+        foreach ([['items' => 'invalid'], ['items' => [['portrait_id' => 999999]]], ['is_visible' => 'invalid']] as $invalid) {
+            try {
+                app(PageOperations::class)->save($actor, [
+                    'title' => 'Invalid', 'slug' => 'invalid', 'template_key' => 'default',
+                    'content_json' => ['sections' => ['testimonials' => $invalid]],
+                ], draftOnly: true);
+                $this->fail('Invalid testimonial content must fail.');
+            } catch (ValidationException $exception) {
+                $this->assertNotEmpty($exception->errors());
+                $this->assertDatabaseCount('pages', 0);
+            }
+        }
+    }
+
+    public function test_editor_can_save_testimonials_but_cannot_publish(): void
+    {
+        $actor = User::factory()->create(['role' => 'editor']);
+        $operations = app(PageOperations::class);
+        $page = $operations->save($actor, [
+            'title' => 'Draft', 'slug' => 'draft-testimonials', 'template_key' => 'default',
+            'content_json' => ['sections' => ['testimonials' => ['heading' => 'Clientes que confían', 'items' => []]]],
+        ], draftOnly: true);
+        $this->assertSame('draft', $page->status);
+        $this->expectException(AuthorizationException::class);
+        $operations->publish($actor, $page);
+    }
+}
