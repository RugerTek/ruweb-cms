diff --git a/tests/Feature/DefaultTestimonialsTest.php b/tests/Feature/DefaultTestimonialsTest.php
new file mode 100644
index 0000000..37a400f
--- /dev/null
+++ b/tests/Feature/DefaultTestimonialsTest.php
@@ -0,0 +1,87 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Media;
+use App\Models\User;
+use App\Services\Pages\PageOperations;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+use Tests\TestCase;
+
+class DefaultTestimonialsTest extends TestCase
+{
+    use RefreshDatabase;
+
+    public function test_shared_save_preserves_content_and_renders_published_testimonials(): void
+    {
+        $this->travelTo(now()->startOfDay());
+        $actor = User::factory()->create(['role' => 'admin']);
+        $portrait = Media::create([
+            'filename' => 'square.webp', 'original_filename' => 'square.webp',
+            'mime_type' => 'image/webp', 'extension' => 'webp', 'size' => 100, 'disk' => 'public',
+            'path' => 'placeholders/square.webp', 'width' => 1200, 'height' => 1200,
+            'placeholder_key' => 'square',
+        ]);
+        $operations = app(PageOperations::class);
+        $page = $operations->save($actor, [
+            'title' => 'Our clients', 'slug' => 'our-clients', 'template_key' => 'default',
+            'content_json' => ['sections' => ['content' => ['heading' => 'Existing section', 'body' => 'Keep this content.']]],
+        ], draftOnly: true);
+        $section = [
+            'heading' => 'Clientes que confían', 'is_visible' => true,
+            'items' => [['quote' => 'El equipo cumplió cada detalle.', 'author' => 'Ana Torres', 'role' => 'Directora', 'portrait_id' => $portrait->id]],
+        ];
+        $page = $operations->save($actor, ['content_json' => ['sections' => ['testimonials' => $section]]], $page, draftOnly: true);
+        $this->assertSame($section, $page->fresh()->sections()['testimonials']);
+        $this->assertSame('Keep this content.', $page->sections()['content']['body']);
+        $this->get('/our-clients')->assertNotFound();
+        $page = $operations->publish($actor, $page);
+        $this->get('/our-clients')->assertOk()->assertSee('Clientes que confían')->assertSee('El equipo cumplió cada detalle.')->assertSee('Ana Torres')->assertSee('Directora')->assertSee($portrait->url(), false)->assertSee('Existing section');
+
+        $page->update(['published_at' => now()->addDay()]);
+        $this->get('/our-clients')->assertNotFound();
+        $page->update(['published_at' => now(), 'content_json' => ['sections' => ['testimonials' => $section]]]);
+        $content = $page->content_json;
+        $content['sections']['testimonials']['is_visible'] = false;
+        $page->update(['content_json' => $content]);
+        $this->get('/our-clients')->assertOk()->assertDontSee('El equipo cumplió cada detalle.');
+        $content['sections']['testimonials']['is_visible'] = true;
+        $content['sections']['testimonials']['items'] = [];
+        $page->update(['content_json' => $content]);
+        $this->get('/our-clients')->assertOk()->assertDontSee('Clientes que confían');
+    }
+
+    public function test_invalid_portrait_is_rejected_by_shared_operations(): void
+    {
+        $this->expectException(ValidationException::class);
+        app(PageOperations::class)->save(User::factory()->create(['role' => 'admin']), [
+            'title' => 'Invalid', 'slug' => 'invalid', 'template_key' => 'default',
+            'content_json' => ['sections' => ['testimonials' => ['items' => [['quote' => 'Quote', 'portrait_id' => 999999]]]]],
+        ], draftOnly: true);
+    }
+
+    public function test_full_editor_exposes_repeater_and_square_media_controls(): void
+    {
+        $actor = User::factory()->create(['role' => 'admin']);
+        $page = app(PageOperations::class)->save($actor, ['title' => 'Editor', 'slug' => 'editor', 'template_key' => 'default'], draftOnly: true);
+        $this->actingAs($actor)->get(route('admin.pages.edit', $page))->assertOk()
+            ->assertSee('data-repeater-key="items"', false)
+            ->assertSee('data-repeater-toggle', false)
+            ->assertSee('data-repeater-remove', false)
+            ->assertSee('data-repeater-move-up', false)
+            ->assertSee('[portrait_id]', false)
+            ->assertSee('aspect-ratio: 1/1', false)
+            ->assertSee('content_json[sections][testimonials][is_visible]', false);
+    }
+
+    public function test_browser_empty_repeater_saves_as_an_empty_list(): void
+    {
+        $actor = User::factory()->create(['role' => 'admin']);
+        $page = app(PageOperations::class)->save($actor, [
+            'title' => 'Empty', 'slug' => 'empty', 'template_key' => 'default', 'status' => 'draft',
+            'content_json' => ['sections' => ['testimonials' => ['items' => '']]],
+        ]);
+        $this->assertSame([], $page->sections()['testimonials']['items']);
+    }
+}
